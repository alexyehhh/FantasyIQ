# --- Postgres ---
POSTGRES_USER=fantasyiq
POSTGRES_PASSWORD=fantasyiq
POSTGRES_DB=fantasyiq
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Backend ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- NBA ingestion via swar/nba_api ---
NBA_API_TIMEOUT_SECONDS=30

# --- Frontend ---
# URL the frontend (browser/server) uses to reach the backend
NEXT_PUBLIC_API_URL=http://localhost:8000
