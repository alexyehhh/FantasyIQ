# --- Postgres ---
POSTGRES_USER=fantasyiq
POSTGRES_PASSWORD=fantasyiq
POSTGRES_DB=fantasyiq
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Backend ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- NBA ingestion via swar/nba_api ---
NBA_API_TIMEOUT_SECONDS=30

# --- NFL ingestion via ESPN's public site API ---
NFL_API_TIMEOUT_SECONDS=30

# --- Background worker (see README, "Keeping the data current") ---
# Minimum gap between any two requests to ESPN, and how often each job runs (seconds).
ESPN_MIN_REQUEST_INTERVAL_SECONDS=0.25
WORKER_LIVE_INTERVAL_SECONDS=15
WORKER_INJURIES_INTERVAL_SECONDS=900
WORKER_DIRECTORY_INTERVAL_SECONDS=21600
WORKER_BACKFILL_INTERVAL_SECONDS=3600
LIVE_REFRESH_COOLDOWN_SECONDS=30
LIVE_REFRESH_TIMEOUT_SECONDS=8

# --- Frontend ---
# URL the frontend (browser/server) uses to reach the backend
NEXT_PUBLIC_API_URL=http://localhost:8000
